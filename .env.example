# Para usar o backend da Trilha Info:
VITE_API_URL=https://api.trilha.info/api
VITE_PUBLIC_URL=https://api.trilha.info/public

# Se possuir o backend rodando localmente, descomente as variaveis abaixo
# VITE_API_URL=http://localhost:8000/api
# VITE_PUBLIC_URL=http://localhost:8000/public
# Sugestões de conteúdo (função /api/contributions na Vercel).
# No desenvolvimento local, sem GITHUB_APP_ID, o envio funciona em modo de teste e não abre PR.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# GITHUB_APP_INSTALLATION_ID=
# Destinos obrigatórios para enviar PRs. Ajuste a branch à usada para receber contribuições.
# CONTRIBUTIONS_REPOSITORY=nyx43/trilha-mod
# CONTRIBUTIONS_BASE_BRANCH=main
# Cloudflare Turnstile: obrigatório nas prévias e em produção na Vercel.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Tutor opcional, para uso local com npm run dev em http://127.0.0.1:5173.
# Basta uma chave para Gemini ou Groq. As opções de modelo são dispensáveis.
# TUTOR_GEMINI_API_KEY=
# TUTOR_GEMINI_MODEL=gemini-4-hydrogen
# TUTOR_GROQ_API_KEY=
# TUTOR_GROQ_MODEL=openai/gpt-oss-120b
#
# Para outro provedor, informe o endpoint completo de Chat Completions e o modelo.
# TUTOR_API_URL=
# TUTOR_MODEL=
# TUTOR_API_KEY=

# Tutor na Vercel. Ative após configurar um provedor e Turnstile.
# Autorize no widget os hostnames em que o tutor vai aparecer.
# A URL única do deploy Vercel entra automaticamente. Liste domínios e aliases HTTPS
# adicionais separados por vírgula.
# TUTOR_ENABLE_HOSTED=true
# TUTOR_ALLOWED_ORIGINS=https://seu-site.example
# TUTOR_TURNSTILE_SITE_KEY=
# TUTOR_TURNSTILE_SECRET_KEY=

# Opcional. Deixe vazio para estudar sem Google Analytics.
VITE_GA_MEASUREMENT_ID=
